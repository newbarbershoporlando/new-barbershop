---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCallBar from '../components/StickyCallBar.astro';
import BackToTop from '../components/BackToTop.astro';
import { GTM_ID, path, altPath, ui, type Lang } from '../data/ui';

/* og:image:alt describes the SHARE image (/images/og-image.jpg — the shop
   logo on the dark brand background), NOT the hero/banner photo, so it
   gets its own strings here. BANNER_ALT in ui.ts stays untouched: it is
   a Sanity siteSettings-fed string and no longer describes this image. */
const OG_IMAGE_ALT = {
  en: 'New Barbershop Orlando logo',
  es: 'Logotipo de New Barbershop Orlando',
} as const;

interface Props {
  lang: Lang;
  /** Page slug without locale prefix ('' for home). */
  slug: string;
  title: string;
  description: string;
  jsonLd?: object | object[];
  /** Homepage only: translucent header floating over the hero photo. */
  overlayHeader?: boolean;
  /** Optional class on <html> (pages rendering the shared
      StickyHero component pass "sticky-hero" so the sticky /
      overflow / reduced-motion rules in global.css scope to
      exactly those pages). Omitted entirely when not passed. */
  htmlClass?: string;
  heroPreload?: boolean;
}
const { lang, slug, title, description, jsonLd, overlayHeader = false, htmlClass, heroPreload = false } = Astro.props;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const site = Astro.site!;
const canonical = new URL(path(lang, slug), site).href;
const altUrl = new URL(altPath(lang, slug), site).href;
const enUrl = new URL(path('en', slug), site).href;
const ogImage = new URL('/images/og-image.jpg', site).href;
---

<!doctype html>
<html lang={lang} class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {heroPreload && (<link rel="preload" as="image" type="image/avif" imagesrcset="/images/hero-home-1080.avif 1080w, /images/hero-home-1600.avif 1600w, /images/hero-home-2560.avif 2560w" imagesizes="100vw" fetchpriority="high" />)}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Full hreflang set incl. the self-referencing entry (pre-launch
        audit M2, owner-authorized 2026-11-16). */}
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={lang === 'en' ? 'es' : 'en'} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={OG_IMAGE_ALT[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <!-- Google Tag Manager -->
    <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${GTM_ID}');`} />
    {/* Upgrade (2026-11-16): JS-available marker. Progressive-enhancement
        styles (scroll reveals, collapsibles) are gated on html.js so
        no-JS visitors and crawlers always see all content in its final
        state. Runs in <head> so the class is set before first paint.
        The same script arms a one-shot watchdog: if the reveal
        observer script at the end of <body> has not initialized (and
        cleared the timer) within 2.5s, all reveal blocks are shown
        outright — content can never be stranded invisible. In normal
        operation the body script runs during the same parse and
        clears the timer immediately, so the watchdog never fires. */}
    <script is:inline>
      document.documentElement.classList.add('js');
      window.__rvWatchdog = setTimeout(function () {
        document.querySelectorAll('[data-rv]').forEach(function (el) { el.classList.add('rv-in'); });
      }, 2500);
    </script>
    {jsonLdBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="GTM"></iframe>
    </noscript>
    <a class="skip-link" href="#main-content">{ui[lang].skipToContent}</a>
    <Header lang={lang} slug={slug} overlay={overlayHeader} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
    <StickyCallBar lang={lang} />
    <BackToTop lang={lang} />
    {/* Upgrade (2026-11-16): scroll-triggered reveals. Elements carry
        data-rv and are visible by default; only html.js styles start
        them faded/translated (see global.css), and this observer adds
        .rv-in ONCE as each enters the viewport. No IntersectionObserver
        or reduced-motion preference -> everything is shown at once.
        Opacity/transform only: no layout shift, and the fixed sticky
        call bar is never a reveal target. */}
    <script is:inline>
      (function () {
        // Observer initializing = the head watchdog is stood down.
        if (window.__rvWatchdog) { clearTimeout(window.__rvWatchdog); window.__rvWatchdog = null; }
        var els = document.querySelectorAll('[data-rv]');
        if (!els.length) return;
        var showAll = function () { els.forEach(function (el) { el.classList.add('rv-in'); }); };
        if (!('IntersectionObserver' in window) ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches) { showAll(); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('rv-in'); io.unobserve(e.target); }
          });
        }, { threshold: 0, rootMargin: '0px 0px -48px 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
    {/* Swipe hints (owner add-on 2026-11-16): reveal each
        [data-swipe-hint] label only while its row genuinely
        overflows (scrollWidth > clientWidth). Pure class toggle —
        the label's slot is reserved by CSS and only visibility
        changes, so this can never shift layout. Re-checked on
        load and on resize. No-JS: labels stay hidden, which is
        correct — peek + native scrolling still communicate. */}
    <script is:inline>
      (function () {
        var hints = document.querySelectorAll('[data-swipe-hint]');
        if (!hints.length) return;
        var check = function () {
          hints.forEach(function (hint) {
            var row = hint.nextElementSibling;
            if (row) hint.classList.toggle('is-on', row.scrollWidth > row.clientWidth + 1);
          });
        };
        check();
        window.addEventListener('load', check);
        var t = 0;
        window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(check, 120); });
      })();
    </script>
    {/* Premium design item 3 (2026-11-16): iOS Safari applies the
        CSS :active press states only while a touch listener exists
        on the document. This empty passive listener is the standard
        enabler — it handles nothing, prevents nothing, and changes
        no behavior beyond letting the press states render on
        iPhones. */}
    <script is:inline>
      document.addEventListener('touchstart', function () {}, { passive: true });
    </script>
  </body>
</html>
