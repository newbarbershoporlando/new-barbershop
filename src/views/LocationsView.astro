---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ShopCard from '../components/ShopCard.astro';
import BlogBand from '../components/BlogBand.astro';
import StickyHero from '../components/StickyHero.astro';
import { ui, path, type Lang } from '../data/ui';
import { locations } from '../data/locations';
import { pageSeo } from '../data/pages';
import { breadcrumbNode } from '../lib/schema';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const seo = pageSeo.locations[lang];
const site = Astro.site!;
---

<BaseLayout
  lang={lang}
  slug="locations"
  title={seo.title}
  description={seo.description}
  jsonLd={breadcrumbNode([
    { name: t.nav.home, url: new URL(path(lang, ''), site).href },
    { name: t.nav.locations, url: new URL(path(lang, 'locations'), site).href },
  ])}
  overlayHeader
  htmlClass="sticky-hero"
  heroPreload
>
  <!-- Hero-v3 treatment (owner order 2026-11-15, same as homepage):
       full-bleed photo band at y=0 with the translucent floating
       header over it; the headline sits on the solid dark band BELOW
       the photo. HARD RULE: no text overlaid on the photo at any
       viewport. Copy and everything below (TrustStrip, location
       cards) unchanged. PHOTO (owner correction 2026-11-16, phone
       pass): the page's own wide banner cover-cropped badly on
       mobile ("too zoomed in", badges clipped) — replaced with the
       HOMEPAGE hero photo and its exact picture markup, so the
       .hero-photo sizing matches the homepage framing for framing
       (desktop natural aspect; mobile 4:3 cover window) and the
       baked-in logo stays fully visible.
       RELEASE CANDIDATE (2026-11-17): the photo band is rendered by
       the shared StickyHero component, so this page gets the same
       sticky/scroll-over hero as the homepage; everything below
       (headline band first) is the component's slot and slides over
       the stationary photo. The page's old photo-watching header
       observer is replaced by the component's sentinel observer —
       same toggle point (photo height − 64px), verified in the RC
       battery. -->
  <!-- Hero upgrade extended (owner, 2026-11-17: "update the rest
       of the site pages with all these updates to the home page we
       just did"): this page now passes StickyHero's `overlay` prop
       exactly as the homepage does — clean high-resolution photo,
       overlaid header-logo layer with the darkened silhouette
       shade and the 1 / 2 markers at the final homepage positions.
       The headline stays on the solid band below the photo; no
       copy moves onto the photo. -->
  <StickyHero lang={lang} overlay>
  <section class="hero">
    <div class="wrap">
      {/* Item 7: eyebrow + heading block, same pattern as About. */}
      <p class="eyebrow" style="text-align:center">{t.eyebrows.visit}</p>
      <h1>{t.ourLocations}</h1>
    </div>
  </section>


  <TrustStrip lang={lang} />

  <section class="section" data-rv>
    <div class="wrap">
      <p class="swipe-hint" data-swipe-hint aria-hidden="true">{t.swipeHint}</p>
      <div class="cards cards--swipe" data-swipe>
        {locations.map((loc) => <ShopCard loc={loc} lang={lang} />)}
      </div>
    </div>
  </section>

  {/* Item 6: the blog band is this page's 2nd light section → paper. */}
  <BlogBand lang={lang} paper />
  </StickyHero>
</BaseLayout>
