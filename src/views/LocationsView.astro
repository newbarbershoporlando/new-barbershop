---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ShopCard from '../components/ShopCard.astro';
import BlogBand from '../components/BlogBand.astro';
import { ui, path, HERO_ALT, type Lang } from '../data/ui';
import { locations } from '../data/locations';
import { pageSeo } from '../data/pages';
import { breadcrumbNode } from '../lib/schema';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const seo = pageSeo.locations[lang];
const site = Astro.site!;
---

<BaseLayout
  lang={lang}
  slug="locations"
  title={seo.title}
  description={seo.description}
  jsonLd={breadcrumbNode([
    { name: t.nav.home, url: new URL(path(lang, ''), site).href },
    { name: t.nav.locations, url: new URL(path(lang, 'locations'), site).href },
  ])}
  overlayHeader
>
  <!-- Hero-v3 treatment (owner order 2026-11-15, same as homepage):
       full-bleed photo band at y=0 with the translucent floating
       header over it; the headline sits on the solid dark band BELOW
       the photo. HARD RULE: no text overlaid on the photo at any
       viewport. Copy and everything below (TrustStrip, location
       cards) unchanged. PHOTO (owner correction 2026-11-16, phone
       pass): the page's own wide banner cover-cropped badly on
       mobile ("too zoomed in", badges clipped) — replaced with the
       HOMEPAGE hero photo and its exact picture markup, so the
       .hero-photo sizing matches the homepage framing for framing
       (desktop natural aspect; mobile 4:3 cover window) and the
       baked-in logo stays fully visible. -->
  <section class="hero-photo" id="heroPhoto">
    <picture>
      <source media="(max-width: 899px)" type="image/webp" srcset="/images/shop1-hero-mobile.webp" />
      <source media="(max-width: 899px)" type="image/jpeg" srcset="/images/shop1-hero-mobile.jpg" />
      <source type="image/webp" srcset="/images/shop1-hero.webp" />
      <img src="/images/shop1-hero.jpg" alt={HERO_ALT[lang]} width="1320" height="743" fetchpriority="high" />
    </picture>
  </section>
  <section class="hero">
    <div class="wrap"><h1>{t.ourLocations}</h1></div>
  </section>

  <script>
    // Overlay header state (same mechanism as HomeView): translucent
    // while this page's photo band is under the header, solid once it
    // scrolls past. Only pages that render #heroPhoto + overlayHeader
    // run this; other interior pages are unaffected.
    const heroBand = document.getElementById('heroPhoto');
    const headerEl = document.getElementById('siteHeader');
    if (heroBand && headerEl && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          headerEl.classList.toggle('header-solid', !entries[0].isIntersecting);
        },
        { rootMargin: '-64px 0px 0px 0px', threshold: 0 },
      ).observe(heroBand);
    }
  </script>

  <TrustStrip lang={lang} />

  <section class="section" data-rv>
    <div class="wrap">
      <div class="cards cards--swipe" data-swipe>
        {locations.map((loc) => <ShopCard loc={loc} lang={lang} />)}
      </div>
    </div>
  </section>

  <BlogBand lang={lang} />
</BaseLayout>
