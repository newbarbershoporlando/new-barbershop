---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import CategoryTiles from '../components/CategoryTiles.astro';
import ShopCard from '../components/ShopCard.astro';
import ReviewsBand from '../components/ReviewsBand.astro';
import BlogBand from '../components/BlogBand.astro';
import HowItWorks from '../components/HowItWorks.astro';
import { ui, path, HERO_ALT, type Lang } from '../data/ui';
import { locations } from '../data/locations';
import { pageSeo, homeCopy, homeGalleryItems } from '../data/pages';
import { homeGraph, galleryImageGraph } from '../lib/schema';
import Gallery from '../components/Gallery.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const c = homeCopy[lang];
const seo = pageSeo.home[lang];
const site = Astro.site!;
---

<BaseLayout lang={lang} slug="" title={seo.title} description={seo.description} jsonLd={[homeGraph(site.href.replace(/\/$/, '')), galleryImageGraph(site.href.replace(/\/$/, ''), homeGalleryItems, lang)]} overlayHeader>
  <!-- Hero — owner requests 2026-11-15 (supersede the banner-strip
       stack of the same day's phone pass): the owner-supplied Shop 1
       interior photo is a full-bleed band at y=0 and the header floats
       OVER it, translucent (see .site-header--overlay). HARD RULE
       unchanged: NO headline, subhead, button or any text overlaid on
       the photo at any viewport — the photo's baked-in logo stays
       fully visible and uncollided. Below the photo, on solid coal:
       H1 → subhead (relocated by the owner's word "Move it", NOT
       deleted) → trust strip. There is NO call-button pair in the
       hero (owner change, same day): the floating bottom call bar is
       the homepage's call action, visible from the top of the page
       exactly as on Contact — see StickyCallBar. -->
  <section class="hero-photo" id="heroPhoto">
    <picture>
      <source media="(max-width: 899px)" type="image/webp" srcset="/images/shop1-hero-mobile.webp" />
      <source media="(max-width: 899px)" type="image/jpeg" srcset="/images/shop1-hero-mobile.jpg" />
      <source type="image/webp" srcset="/images/shop1-hero.webp" />
      <img src="/images/shop1-hero.jpg" alt={HERO_ALT[lang]} width="1320" height="743" fetchpriority="high" />
    </picture>
  </section>
  <section class="hero">
    <div class="wrap">
      <h1>{c.heroH1}</h1>
      <p class="hero-sub">{c.heroLine}</p>
    </div>
  </section>

  <script>
    // Overlay header state: translucent while the hero photo is under
    // the header, solid once the photo's bottom edge passes the
    // header's bottom edge (rootMargin trims the root by the 64px
    // header height). Homepage only — other pages never render
    // #heroPhoto and never get the overlay class.
    const heroBand = document.getElementById('heroPhoto');
    const headerEl = document.getElementById('siteHeader');
    if (heroBand && headerEl && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          headerEl.classList.toggle('header-solid', !entries[0].isIntersecting);
        },
        { rootMargin: '-64px 0px 0px 0px', threshold: 0 },
      ).observe(heroBand);
    }
  </script>

  <script>
    // Parallax hero (owner request 2026-11-17, PREVIEW ONLY): the hero
    // photo progressively HIDES as the user scrolls down and reveals
    // again scrolling back up. The visible state is a pure function of
    // scrollY — scrubbed, bidirectional, no timers, no hysteresis:
    //   progress p = clamp(scrollY / (band height × 0.95), 0, 1)
    //   picture clip-path inset-top grows 0% → 100% (the photo's lower
    //   portion stays in view longest, so the photo reads as pinned
    //   while the page scrolls past — the parallax depth), and the img
    //   drifts down slightly while scaling 1.00 → 1.06 (the scale bleed,
    //   3p% per side, always covers the ≤2p% drift, so no gap can open).
    // At p = 0 both inline styles are REMOVED — scrollY 0 is pixel-
    // identical to the pre-parallax site. Only clip-path + transform
    // are ever touched: the hero's layout box never changes (CLS 0),
    // and the hero carries NO opacity/visibility gate (LCP protection,
    // commit 9471852 precedent). Gates: no-JS → this script never runs
    // and the site is exactly the static site; prefers-reduced-motion
    // → the effect is never armed. rAF is on-demand (scheduled by the
    // passive scroll listener / resize), never a standing loop.
    (function () {
      var band = document.getElementById('heroPhoto');
      if (!band) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var pic = band.querySelector('picture');
      var img = band.querySelector('img');
      if (!pic || !img) return;
      var range = band.offsetHeight * 0.95;
      var ticking = false;
      function apply() {
        ticking = false;
        var p = range > 0 ? Math.min(1, Math.max(0, window.scrollY / range)) : 0;
        if (p <= 0) {
          pic.style.clipPath = '';
          pic.style.webkitClipPath = '';
          img.style.transform = '';
          return;
        }
        var clip = 'inset(' + (p * 100).toFixed(2) + '% 0 0 0)';
        pic.style.clipPath = clip;
        pic.style.webkitClipPath = clip;
        img.style.transform =
          'translate3d(0, ' + (p * 2).toFixed(3) + '%, 0) scale(' + (1 + p * 0.06).toFixed(4) + ')';
      }
      function schedule() {
        if (!ticking) { ticking = true; window.requestAnimationFrame(apply); }
      }
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', function () {
        range = band.offsetHeight * 0.95;
        schedule();
      });
      apply();
    })();
  </script>

  <TrustStrip lang={lang} />

  <!-- Work gallery — owner addition 2026-11-15: real client photos
       only (homeGalleryItems), high on the page so visitors see the
       shop's work early. Same treatment as the Services gallery. -->
  <section class="section" id="workGallery" data-rv>
    <div class="wrap">
      <p class="eyebrow">{t.eyebrows.work}</p>
      <h2>{c.workHeading}</h2>
      <p style="max-width:800px">{c.workIntro}</p>
      <Gallery items={homeGalleryItems} lang={lang} />
    </div>
  </section>

  <!-- Locations — moved directly under the work gallery by owner
       order 2026-11-16 (was below How It Works). The block moves
       whole: same markup, classes, copy and ShopCard links. -->
  <section class="section section--paper" data-rv>
    <div class="wrap">
      <p class="eyebrow">{t.eyebrows.locations}</p>
      <h2>{t.ourLocations}</h2>
      <p>{c.locationsLine}</p>
      <p class="swipe-hint" data-swipe-hint aria-hidden="true">{t.swipeHint}</p>
      <div class="cards cards--swipe" data-swipe>
        {locations.map((loc) => <ShopCard loc={loc} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- Services preview: 5 category tiles -->
  <section class="section" data-rv>
    <div class="wrap">
      <p class="eyebrow">{t.eyebrows.services}</p>
      <h2>{c.servicesHeading}</h2>
      <p>{c.servicesIntro}</p>
      <CategoryTiles lang={lang} />
      <p style="margin-top:24px">
        <a class="btn btn--ghost-light" href={path(lang, 'contact')}>{t.callForPrices}</a>
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="section section--dark" data-rv>
    <div class="wrap">
      <p class="eyebrow">{t.eyebrows.story}</p>
      <h2>{c.storyHeading}</h2>
      <p style="max-width:760px">{c.storyBody}</p>
      <a class="btn btn--ghost-dark" href={path(lang, 'about')}>{t.learnMore}</a>
    </div>
  </section>

  <!-- Experience — premium design item 6 (2026-11-16): paper band.
       Light sections now alternate strictly (work W, locations P,
       services W, experience P, how-it-works W, blog P); the old
       Experience + How It Works run was 1,648px of unbroken white. -->
  <section class="section section--paper" data-rv>
    <div class="wrap">
      <p class="eyebrow">{t.eyebrows.experience}</p>
      <h2>{c.experienceHeading}</h2>
      <p style="max-width:760px">{c.experienceIntro}</p>
      <div class="cards">
        {c.experienceCards.map((card) => (
          <article class="card">
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            <a class="btn btn--ghost-light" href={path(lang, 'services')}>{t.learnMore}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <HowItWorks lang={lang} />

  <ReviewsBand lang={lang} />
  {/* Item 6: the blog band is this page's 6th light section → paper. */}
  <BlogBand lang={lang} paper />
</BaseLayout>
