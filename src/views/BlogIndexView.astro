---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui, path, type Lang } from '../data/ui';
import { posts, postThumb } from '../data/posts';
import { pageSeo } from '../data/pages';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const seo = pageSeo.blog[lang];
---

<BaseLayout lang={lang} slug="blog" title={seo.title} description={seo.description}>
  <section class="section" data-rv>
    <div class="wrap">
      <h1>{t.blogBandHeading}</h1>
      <div class="post-cards">
        {posts.map((post) => {
          const loc = post.locales[lang];
          return (
            <article class="card">
              <a href={path(lang, post.slug)}>
                <img src={postThumb(post)} alt={post.imageAlt[lang]} loading="lazy" decoding="async" width="480" height="320" style="border-radius:8px;margin-bottom:14px" />
              </a>
              <h2><a href={path(lang, post.slug)}>{loc.title}</a></h2>
              <p>{loc.intro.slice(0, 160)}…</p>
              <a href={path(lang, post.slug)}>{t.readPost}</a>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
