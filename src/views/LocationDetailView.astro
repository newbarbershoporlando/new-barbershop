---
// Location page stack per the design-patterns study §5.4:
// hero → intro → Call+Directions action row → FULL hours table → photos band →
// services-at-a-glance tiles → reviews → FAQ → cross-link to the other shop.
// (Premium design item 2, 2026-11-16: the action row moved above the
// hours table — it rendered below the fold at y≈1039/1126; same
// elements, classes and data-shop attribution, DOM order only.)
import BaseLayout from '../layouts/BaseLayout.astro';
import HoursTable from '../components/HoursTable.astro';
import CategoryTiles from '../components/CategoryTiles.astro';
import ReviewsBand from '../components/ReviewsBand.astro';
import FaqBlock from '../components/FaqBlock.astro';
import BlogBand from '../components/BlogBand.astro';
import HowItWorks from '../components/HowItWorks.astro';
import { ui, path, INSTAGRAM_URL, type Lang } from '../data/ui';
import { locations, type Location } from '../data/locations';
import { faqsFor } from '../data/faqs';
import { pageSeo } from '../data/pages';
import { locationGraph, faqPageNode, breadcrumbNode } from '../lib/schema';

interface Props { lang: Lang; loc: Location }
const { lang, loc } = Astro.props;
const t = ui[lang];
const seo = pageSeo[loc._id as 'shop1' | 'shop2'][lang];
const other = locations.find((l) => l._id !== loc._id)!;
const scope = loc._id as 'shop1' | 'shop2';
// Tracking contract (tracking-impl §2, audit H5): data-shop values use
// the shop_1 / shop_2 form the GTM variables expect.
const shopKey = scope === 'shop1' ? 'shop_1' : 'shop_2';
const otherKey = scope === 'shop1' ? 'shop_2' : 'shop_1';
const site = Astro.site!;
const siteRoot = site.href.replace(/\/$/, '');
const abs = (slug: string) => new URL(path(lang, slug), site).href;
---

<BaseLayout
  lang={lang}
  slug={`locations/${loc.slug}`}
  title={seo.title}
  description={seo.description}
  jsonLd={[
    locationGraph(loc, siteRoot),
    faqPageNode(faqsFor(scope), lang),
    breadcrumbNode([
      { name: t.nav.home, url: abs('') },
      { name: t.nav.locations, url: abs('locations') },
      { name: loc.name, url: abs(`locations/${loc.slug}`) },
    ]),
  ]}
>
  <section class="page-hero">
    <div class="wrap"><h1>{loc.name}</h1></div>
  </section>

  <section class="section" data-rv>
    <div class="wrap">
      <h2>{loc.introHeading[lang]}</h2>
      <p style="max-width:760px">{loc.intro[lang]}</p>
      <p>
        {loc.street}, {loc.city}, {loc.state} {loc.zip} · <a class="cta-call cta-page" data-shop={shopKey} href={loc.phoneHref}>{loc.phoneDisplay}</a>
        · <a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram</a>
      </p>

      <div class="action-row action-row--detail">
        <a class="btn btn--call cta-call cta-page" data-shop={shopKey} href={loc.phoneHref}>
          ☎ {loc._id === 'shop1' ? t.callShop1 : t.callShop2} · {loc.phoneDisplay}
        </a>
        <a class="btn btn--ghost-light" data-shop={shopKey} href={loc.mapsUrl} target="_blank" rel="noopener">{t.getDirections}</a>
        {loc.whatsapp && (
          <a class="btn btn--whatsapp" data-shop={shopKey} href={loc.whatsapp} target="_blank" rel="noopener">{t.whatsapp}</a>
        )}
      </div>

      <HoursTable loc={loc} lang={lang} />
    </div>
  </section>

  <HowItWorks lang={lang} />

  <section class="section section--paper" data-rv>
    <div class="wrap">
      <h2>{t.photosHeading}</h2>
      <!-- This shop's OWN real photos (owner-supplied 2026-11-15 — genuine
           interiors, replacing the banner crops that stood in for them,
           manifest §2). The scaffold's shared stock set must never stand
           in for a specific shop. -->
      <img src={loc.photo} alt={loc.photoAlt[lang]} loading="lazy" decoding="async" width={loc.photoSize?.w ?? 800} height={loc.photoSize?.h ?? 600} style="border-radius:8px;max-width:100%;height:auto" />
      {loc.photo2 && loc.photo2Alt && (
        <img src={loc.photo2} alt={loc.photo2Alt[lang]} loading="lazy" decoding="async" width={loc.photo2Size?.w ?? 1086} height={loc.photo2Size?.h ?? 1448} style="border-radius:8px;max-width:min(480px,100%);height:auto;margin-top:16px" />
      )}
    </div>
  </section>

  <section class="section" data-rv>
    <div class="wrap">
      <h2>{t.servicesAtGlance}</h2>
      <CategoryTiles lang={lang} forShop={scope} />
      <p style="margin-top:20px">
        <a class="btn btn--ghost-light" data-shop={shopKey} href={loc.mapsUrl} target="_blank" rel="noopener">
          {t.seeWork(loc._id === 'shop1' ? 1 : 2)}
        </a>
      </p>
    </div>
  </section>

  <ReviewsBand lang={lang} only={loc} heading={false} />

  <FaqBlock lang={lang} items={faqsFor(scope)} />

  <section class="section section--paper" data-rv>
    <div class="wrap">
      <h2>{t.alsoVisit}</h2>
      <p>
        <strong>{other.name}</strong> — {other.area[lang]} · {other.street}, {other.city}, {other.state} {other.zip}
        · <a class="cta-call cta-page" data-shop={otherKey} href={other.phoneHref}>{other.phoneDisplay}</a>
      </p>
      <a class="btn btn--ghost-light" href={path(lang, `locations/${other.slug}`)}>
        {other._id === 'shop1' ? t.visitShop1 : t.visitShop2}
      </a>
    </div>
  </section>

  <BlogBand lang={lang} />
</BaseLayout>
