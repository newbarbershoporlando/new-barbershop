---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqBlock from '../components/FaqBlock.astro';
import BlogBand from '../components/BlogBand.astro';
import SvcGroup from '../components/SvcGroup.astro';
import { ui, type Lang } from '../data/ui';
import { shop1, shop2 } from '../data/locations';
import { categories } from '../data/services';
import { featuredTestimonial } from '../data/reviews';
import { faqsFor } from '../data/faqs';
import { pageSeo, servicesCopy, galleryItems } from '../data/pages';
import { galleryImageGraph } from '../lib/schema';
import Gallery from '../components/Gallery.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const c = servicesCopy[lang];
const seo = pageSeo.services[lang];
const site = Astro.site!;
---

<BaseLayout lang={lang} slug="services" title={seo.title} description={seo.description} jsonLd={galleryImageGraph(site.href.replace(/\/$/, ''), galleryItems, lang)}>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.heading}</h1>
      <p style="max-width:800px">{c.intro}</p>

      {/* Upgrade (2026-11-16): the two most important categories
          (Haircuts & Fades, Beard & Shave) render immediately; the
          remaining categories sit in the "View All" region. ALL of
          them are in the server-rendered HTML — the region is only
          visually collapsed when JS is available (html.js + the
          script below), so no-JS visitors and crawlers see the full
          list. Availability is never mixed: this page lists the
          combined menu exactly as before (braids category copy keeps
          its Shop 1 attribution in its own text). */}
      {categories.slice(0, 2).map((cat) => <SvcGroup cat={cat} lang={lang} />)}

      <div class="svc-more" id="svcMore" data-svc-more>
        <div class="svc-more-in">
          {categories.slice(2).map((cat) => <SvcGroup cat={cat} lang={lang} />)}
        </div>
      </div>
      <p class="svc-toggle-row">
        <button type="button" class="btn btn--ghost-light" data-svc-toggle aria-expanded="false" aria-controls="svcMore">
          <span data-svc-toggle-label data-more={t.viewAllServices} data-fewer={t.showFewerServices}>{t.viewAllServices}</span>
        </button>
      </p>

      <script>
        const svcWrap = document.querySelector('[data-svc-more]');
        const svcBtn = document.querySelector('[data-svc-toggle]');
        if (svcWrap && svcBtn) {
          const svcLabel = svcBtn.querySelector('[data-svc-toggle-label]');
          svcWrap.classList.add('svc-collapsed');
          svcBtn.addEventListener('click', () => {
            const collapsed = svcWrap.classList.toggle('svc-collapsed');
            svcBtn.setAttribute('aria-expanded', String(!collapsed));
            if (svcLabel) svcLabel.textContent = collapsed ? svcLabel.dataset.more : svcLabel.dataset.fewer;
            // The groups inside carry data-rv reveals; while collapsed
            // they are visibility:hidden, which also suspends their
            // IntersectionObserver entries — reveal them outright on
            // expand so expanded content is never left transparent.
            if (!collapsed) svcWrap.querySelectorAll('[data-rv]').forEach((el) => el.classList.add('rv-in'));
          });
        }
      </script>

      <div data-rv>
        <h2>{c.galleryHeading}</h2>
        <p style="max-width:800px">{c.galleryIntro}</p>
        <Gallery items={galleryItems} lang={lang} />
      </div>

      <div class="action-row" style="margin-top:24px">
        <a class="btn btn--ghost-light" data-shop="shop_1" href={shop1.mapsUrl} target="_blank" rel="noopener">{t.seeWork(1)}</a>
        <a class="btn btn--ghost-light" data-shop="shop_2" href={shop2.mapsUrl} target="_blank" rel="noopener">{t.seeWork(2)}</a>
      </div>

      {/* Directions (round-3 Item 2c, owner's conditional inclusion):
          shop-named labels — the bare 'Get Directions' would read
          identically twice here with no shop context. Same pattern:
          data-shop attribution, no btn-reviews, no cta-* classes. */}
      <div class="action-row" style="margin-top:12px">
        <a class="btn btn--ghost-light" data-shop="shop_1" href={shop1.mapsUrl} target="_blank" rel="noopener">{t.directionsShop1}</a>
        <a class="btn btn--ghost-light" data-shop="shop_2" href={shop2.mapsUrl} target="_blank" rel="noopener">{t.directionsShop2}</a>
      </div>
    </div>
  </section>

  <FaqBlock lang={lang} items={faqsFor('general')} />

  <section class="section section--dark" data-rv>
    <div class="wrap">
      <div class="testimonial">
        <div class="stars-line" aria-label={t.ariaStars}>★★★★★</div>
        <blockquote>“{featuredTestimonial.text[lang]}”</blockquote>
        <p class="who">— {featuredTestimonial.author}</p>
      </div>
    </div>
  </section>

  <BlogBand lang={lang} />
</BaseLayout>
