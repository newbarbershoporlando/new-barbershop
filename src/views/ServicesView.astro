---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqBlock from '../components/FaqBlock.astro';
import BlogBand from '../components/BlogBand.astro';
import { ui, type Lang } from '../data/ui';
import { shop1, shop2 } from '../data/locations';
import { categories, servicesByCategory } from '../data/services';
import { featuredTestimonial } from '../data/reviews';
import { faqsFor } from '../data/faqs';
import { pageSeo, servicesCopy, galleryItems } from '../data/pages';
import { galleryImageGraph } from '../lib/schema';
import Gallery from '../components/Gallery.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const c = servicesCopy[lang];
const seo = pageSeo.services[lang];
const site = Astro.site!;
---

<BaseLayout lang={lang} slug="services" title={seo.title} description={seo.description} jsonLd={galleryImageGraph(site.href.replace(/\/$/, ''), galleryItems, lang)}>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.heading}</h1>
      <p style="max-width:800px">{c.intro}</p>

      {categories.map((cat) => (
        <div class="svc-group" id={cat.slug}>
          <h2>{cat.heading[lang]}</h2>
          <p class="benefit">{cat.benefit[lang]}</p>
          <table class="svc">
            <thead>
              <tr>
                <th>{lang === 'en' ? 'Service' : 'Servicio'}</th>
                <th>{lang === 'en' ? 'Description' : 'Descripción'}</th>
              </tr>
            </thead>
            <tbody>
              {servicesByCategory(cat._id).map((svc) => (
                <tr>
                  <td class="name">{svc.name[lang]}</td>
                  <td class="desc">{svc.description[lang]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}

      <h2>{c.galleryHeading}</h2>
      <p style="max-width:800px">{c.galleryIntro}</p>
      <Gallery items={galleryItems} lang={lang} />

      <div class="action-row" style="margin-top:24px">
        <a class="btn btn--ghost-light" data-shop="shop_1" href={shop1.mapsUrl} target="_blank" rel="noopener">{t.seeWork(1)}</a>
        <a class="btn btn--ghost-light" data-shop="shop_2" href={shop2.mapsUrl} target="_blank" rel="noopener">{t.seeWork(2)}</a>
      </div>

      {/* Directions (round-3 Item 2c, owner's conditional inclusion):
          shop-named labels — the bare 'Get Directions' would read
          identically twice here with no shop context. Same pattern:
          data-shop attribution, no btn-reviews, no cta-* classes. */}
      <div class="action-row" style="margin-top:12px">
        <a class="btn btn--ghost-light" data-shop="shop_1" href={shop1.mapsUrl} target="_blank" rel="noopener">{t.directionsShop1}</a>
        <a class="btn btn--ghost-light" data-shop="shop_2" href={shop2.mapsUrl} target="_blank" rel="noopener">{t.directionsShop2}</a>
      </div>
    </div>
  </section>

  <FaqBlock lang={lang} items={faqsFor('general')} />

  <section class="section section--dark">
    <div class="wrap">
      <div class="testimonial">
        <div class="stars-line" aria-label={t.ariaStars}>★★★★★</div>
        <blockquote>“{featuredTestimonial.text[lang]}”</blockquote>
        <p class="who">— {featuredTestimonial.author}</p>
      </div>
    </div>
  </section>

  <BlogBand lang={lang} />
</BaseLayout>
