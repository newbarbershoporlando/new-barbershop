---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShopCard from '../components/ShopCard.astro';
import BlogBand from '../components/BlogBand.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { faqsFor } from '../data/faqs';
import { ui, INSTAGRAM_URL, type Lang } from '../data/ui';
import { locations } from '../data/locations';
import { pageSeo, contactCopy } from '../data/pages';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = contactCopy[lang];
const seo = pageSeo.contact[lang];
const contactFaqs = faqsFor('general').filter((f) => f._id !== 'faq-g-book');
---

<BaseLayout lang={lang} slug="contact" title={seo.title} description={seo.description}>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{ui[lang].eyebrows.contact}</p>
      <h1>{c.heading}</h1>
      <p style="max-width:800px">{c.intro}</p>
      <p class="swipe-hint" data-swipe-hint aria-hidden="true">{ui[lang].swipeHint}</p>
      <div class="cards cards--swipe" data-swipe>
        {locations.map((loc) => <ShopCard loc={loc} lang={lang} />)}
      </div>
      <p style="margin-top:24px">
        {c.instagramLead}{' '}
        <a class="btn btn--ghost-light" href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram — @new.barbershoop</a>
      </p>
    </div>
  </section>

  <HowItWorks lang={lang} paper />
  <FaqBlock lang={lang} items={contactFaqs} />

  {/* Item 6: the blog band is this page's 2nd light section → paper
      (the whole page was white between header and footer). */}
  <BlogBand lang={lang} paper />
</BaseLayout>
