---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui, path, type Lang } from '../data/ui';
import { shop1, shop2 } from '../data/locations';
import { getPost } from '../data/posts';
import { blogPostingNode } from '../lib/schema';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const t = ui[lang];
const post = getPost(slug);
const loc = post.locales[lang];
const site = Astro.site!;
const siteRoot = site.href.replace(/\/$/, '');
---

<BaseLayout
  lang={lang}
  slug={post.slug}
  title={loc.seoTitle}
  description={loc.metaDescription}
  jsonLd={blogPostingNode({
    siteUrl: siteRoot,
    pageUrl: new URL(path(lang, post.slug), site).href,
    headline: loc.title,
    description: loc.metaDescription,
    imagePath: post.image,
    lang,
  })}
>
  <section class="section">
    <div class="wrap">
      <div class="post-body">
        <h1>{loc.title}</h1>
        <img class="post-hero-img" src={post.image} alt={post.imageAlt[lang]} width="1024" height="682" />
        <p>{loc.intro}</p>
        {post.sections.map((sec) => (
          <>
            <h2>{sec.heading[lang]}</h2>
            <p>{sec.body[lang]}</p>
          </>
        ))}
        <p>{loc.closing}</p>
        <p>
          <a href={path(lang, 'services')}>{t.seeServices}</a> · <a href={path(lang, 'contact')}>{t.contactUs}</a>
        </p>
        <div class="btn-stack" style="margin-top:20px">
          <a class="btn btn--call cta-call cta-page" data-shop="shop_1" href={shop1.phoneHref}>☎ {t.callShop1} · {shop1.phoneDisplay}</a>
          <a class="btn btn--call cta-call cta-page" data-shop="shop_2" href={shop2.phoneHref}>☎ {t.callShop2} · {shop2.phoneDisplay}</a>
        </div>
        <p style="margin-top:28px"><a href={path(lang, 'blog')}>{t.backToBlog}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
