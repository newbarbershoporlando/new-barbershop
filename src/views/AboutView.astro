---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShopCard from '../components/ShopCard.astro';
import BlogBand from '../components/BlogBand.astro';
import { ui, HERO_ALT, type Lang } from '../data/ui';
import { locations, shop1, shop2 } from '../data/locations';
import { pageSeo, aboutCopy } from '../data/pages';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = aboutCopy[lang];
const seo = pageSeo.about[lang];
const shops = [shop1, shop2];
---

<BaseLayout lang={lang} slug="about" title={seo.title} description={seo.description} overlayHeader>
  <!-- Hero-v3 treatment (owner order 2026-11-15, same as homepage):
       full-bleed photo band at y=0 with the translucent floating
       header over it; the headline block sits on the solid dark band
       BELOW the photo. HARD RULE: no text overlaid on the photo at
       any viewport. Copy unchanged. PHOTO (owner correction
       2026-11-16, phone pass): the page's own wide banner cover-
       cropped badly on mobile ("too zoomed in", badges clipped) —
       replaced with the HOMEPAGE hero photo and its exact picture
       markup, so the .hero-photo sizing matches the homepage
       framing for framing (desktop natural aspect; mobile 4:3
       cover window) and the baked-in logo stays fully visible. -->
  <section class="hero-photo" id="heroPhoto">
    <picture>
      <source media="(max-width: 899px)" type="image/webp" srcset="/images/shop1-hero-mobile.webp" />
      <source media="(max-width: 899px)" type="image/jpeg" srcset="/images/shop1-hero-mobile.jpg" />
      <source type="image/webp" srcset="/images/shop1-hero.webp" />
      <img src="/images/shop1-hero.jpg" alt={HERO_ALT[lang]} width="1320" height="743" fetchpriority="high" />
    </picture>
  </section>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="text-align:center">{c.eyebrow}</p>
      <h1>{c.heading}</h1>
    </div>
  </section>

  <script>
    // Overlay header state (same mechanism as HomeView): translucent
    // while this page's photo band is under the header, solid once it
    // scrolls past. Only pages that render #heroPhoto + overlayHeader
    // run this; other interior pages are unaffected.
    const heroBand = document.getElementById('heroPhoto');
    const headerEl = document.getElementById('siteHeader');
    if (heroBand && headerEl && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          headerEl.classList.toggle('header-solid', !entries[0].isIntersecting);
        },
        { rootMargin: '-64px 0px 0px 0px', threshold: 0 },
      ).observe(heroBand);
    }
  </script>

  <section class="section" data-rv>
    <div class="wrap" style="max-width:800px">
      <p style="font-size:20px;font-weight:600">{c.lead}</p>
      <p>{c.body1}</p>
      {/* Upgrade (2026-11-16): Read More, mobile only. body1 stays
          visible always — it carries the addresses and phone numbers.
          body2 (story/services prose; exact hours also appear in this
          page's shop cards below) collapses behind the toggle ONLY
          below 900px and ONLY with JS (see .readmore rules in
          global.css); desktop and no-JS render it in full. */}
      <div class="readmore" id="aboutMore" data-readmore>
        <div class="readmore-in">
          <p>{c.body2}</p>
        </div>
      </div>
      <p class="readmore-row">
        <button type="button" class="btn btn--ghost-light" data-readmore-toggle aria-expanded="false" aria-controls="aboutMore">
          <span data-readmore-label data-more={ui[lang].readMore} data-less={ui[lang].showLess}>{ui[lang].readMore}</span>
        </button>
      </p>
      <script>
        const rmWrap = document.querySelector('[data-readmore]');
        const rmBtn = document.querySelector('[data-readmore-toggle]');
        if (rmWrap && rmBtn) {
          const rmLabel = rmBtn.querySelector('[data-readmore-label]');
          rmWrap.classList.add('readmore-collapsed');
          rmBtn.addEventListener('click', () => {
            const collapsed = rmWrap.classList.toggle('readmore-collapsed');
            rmBtn.setAttribute('aria-expanded', String(!collapsed));
            if (rmLabel) rmLabel.textContent = collapsed ? rmLabel.dataset.more : rmLabel.dataset.less;
          });
        }
      </script>
    </div>
  </section>

  <section class="section section--paper" data-rv>
    <div class="wrap">
      <h2>{c.valuesHeading}</h2>
      <p>{c.valuesIntro}</p>
      <div class="values">
        {c.values.map((v) => (
          <article class="card">
            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-rv>
    <div class="wrap">
      <h2>{c.teamHeading}</h2>
      <div class="btn-row">
        {shops.map((loc, i) => (
          <a class="btn btn--ghost-light" data-shop={loc._id === 'shop1' ? 'shop_1' : 'shop_2'} href={loc.mapsUrl} target="_blank" rel="noopener">
            {c.teamButton(i + 1)}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper" data-rv>
    <div class="wrap">
      <div class="cards cards--swipe" data-swipe>
        {locations.map((loc) => <ShopCard loc={loc} lang={lang} />)}
      </div>
    </div>
  </section>

  <BlogBand lang={lang} />
</BaseLayout>
