---
import { ui, type Lang } from '../data/ui';
import { shop1, shop2 } from '../data/locations';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---

<div class="call-bar" id="callBar" aria-label={t.callToBook}>
  {/* Tracking contract (tracking-impl §2, audit H5): cta-call +
      cta-sticky placement classes; data-shop identifies the shop. */}
  {/* Round-3 L2: bar-only labels (barCallShop1/2); the ☎ glyph sits in
      a span so CSS can hide it in the mobile bar only (≤480px) — the
      header keeps its glyph. hrefs/classes/data-shop unchanged. */}
  <a class="cta-call cta-sticky" data-shop="shop_1" href={shop1.phoneHref}><span class="cb-glyph" aria-hidden="true">☎ </span>{t.barCallShop1}</a>
  <a class="cta-call cta-sticky" data-shop="shop_2" href={shop2.phoneHref}><span class="cb-glyph" aria-hidden="true">☎ </span>{t.barCallShop2}</a>
</div>

<!-- The bar is always visible, on every page, from the top of the
     page. It used to defer on the homepage until the hero call stack
     scrolled away (hero-fix-review.md §2.3); the owner removed the
     hero button pair on 2026-11-15 and made this bar the homepage's
     call action, so the defer script and its CSS are gone. -->
