---
/* One services category group (heading + benefit line + price-free
   table). Extracted from ServicesView (Upgrade, 2026-11-16) so the
   primary groups and the "View All" overflow groups render through
   the exact same markup. Content, classes and structure unchanged. */
import type { Lang } from '../data/ui';
import { servicesByCategory, type ServiceCategory } from '../data/services';

interface Props { cat: ServiceCategory; lang: Lang }
const { cat, lang } = Astro.props;
---

<div class="svc-group" id={cat.slug} data-rv>
  <h2>{cat.heading[lang]}</h2>
  <p class="benefit">{cat.benefit[lang]}</p>
  <table class="svc">
    <thead>
      <tr>
        <th>{lang === 'en' ? 'Service' : 'Servicio'}</th>
        <th>{lang === 'en' ? 'Description' : 'Descripción'}</th>
      </tr>
    </thead>
    <tbody>
      {servicesByCategory(cat._id).map((svc) => (
        <tr>
          <td class="name">{svc.name[lang]}</td>
          <td class="desc">{svc.description[lang]}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
