---
import { ui, path, type Lang } from '../data/ui';

interface Props {
  lang: Lang;
  /** Premium design item 6 (2026-11-16): band alternation — the
      caller assigns the paper band where this closing band is the
      page's even-numbered light section. Default stays white. */
  paper?: boolean;
}
const { lang, paper = false } = Astro.props;
const t = ui[lang];
---

<section class:list={['section', 'blog-band', { 'section--paper': paper }]} data-rv>
  <div class="wrap">
    <div class="in">
      <h2>{t.blogBandHeading}</h2>
      <p>{t.blogBandLine}</p>
      <a class="btn btn--call" href={path(lang, 'blog')}>{t.blogBandButton}</a>
    </div>
  </div>
</section>
