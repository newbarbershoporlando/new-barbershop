---
import { type Lang } from '../data/ui';
import { howItWorks } from '../data/pages';

interface Props {
  lang: Lang;
  /** Premium design item 6 (2026-11-16): band alternation — the
      caller assigns the paper band where this section is the
      page's second light section. Default stays white. */
  paper?: boolean;
}
const { lang, paper = false } = Astro.props;
const c = howItWorks[lang];
---

<section class:list={['section', { 'section--paper': paper }]} data-rv>
  <div class="wrap">
    <h2>{c.heading}</h2>
    <p style="max-width:760px">{c.intro}</p>
    <div class="cards">
      {c.steps.map((step, i) => (
        <article class="card">
          <h3>{i + 1}. {step.title}</h3>
          <p>{step.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
