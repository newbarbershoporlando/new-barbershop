---
import { ui, type Lang } from '../data/ui';
import { howItWorks, howItWorksStep1ByShop } from '../data/pages';

interface Props {
  lang: Lang;
  /** Premium design item 6 (2026-11-16): band alternation — the
      caller assigns the paper band where this section is the
      page's second light section. Default stays white. */
  paper?: boolean;
  /** Post-redesign audit fix (2026-11-17): location detail pages pass
      their own shop so step 1 leads with that shop's number only.
      Absent (homepage) = the shared both-shops step. */
  shop?: 'shop1' | 'shop2';
}
const { lang, paper = false, shop } = Astro.props;
const base = howItWorks[lang];
const c = shop
  ? {
      ...base,
      steps: base.steps.map((s, i) =>
        i === 0 ? { ...s, body: howItWorksStep1ByShop[lang][shop] } : s,
      ),
    }
  : base;
---

<section class:list={['section', { 'section--paper': paper }]} data-rv>
  <div class="wrap">
    <p class="eyebrow">{ui[lang].eyebrows.howItWorks}</p>
    <h2>{c.heading}</h2>
    <p style="max-width:760px">{c.intro}</p>
    <div class="cards cards--3">
      {c.steps.map((step, i) => (
        <article class="card">
          <h3>{i + 1}. {step.title}</h3>
          <p>{step.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
