---
import { ui, path, type Lang } from '../data/ui';
import type { Location } from '../data/locations';

interface Props {
  loc: Location;
  lang: Lang;
  /** Show the "Visit the Shop page" link (default true). */
  showVisit?: boolean;
}
const { loc, lang, showVisit = true } = Astro.props;
const t = ui[lang];
---

<article class="card">
  <h2>{loc.name}</h2>
  <p class="area">{loc.area[lang]}</p>
  <p class="addr">{loc.street}<br />{loc.city}, {loc.state} {loc.zip}</p>
  <p class="hours-line">{loc.hoursSummary[lang]}</p>
  <p class="phone-big"><a class="cta-call cta-card" data-shop={loc._id === 'shop1' ? 'shop_1' : 'shop_2'} href={loc.phoneHref}>{loc.phoneDisplay}</a></p>
  <div class="btn-row">
    <a class="btn btn--call cta-call cta-card" data-shop={loc._id === 'shop1' ? 'shop_1' : 'shop_2'} href={loc.phoneHref}>☎ {t.callToBook}</a>
    {loc.whatsapp && (
      <a class="btn btn--whatsapp" data-shop={loc._id === 'shop1' ? 'shop_1' : 'shop_2'} href={loc.whatsapp} target="_blank" rel="noopener">{t.whatsapp}</a>
    )}
  </div>
  {showVisit && (
    <p style="margin-top:14px;margin-bottom:0">
      <a href={path(lang, `locations/${loc.slug}`)}>
        {loc._id === 'shop1' ? t.visitShop1 : t.visitShop2}
      </a>
    </p>
  )}
</article>
