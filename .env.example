# New Barbershop — environment template (copy to `.env` for local work;
# in production these live in Cloudflare Pages → Settings → Environment
# variables, Production + Preview). Names/defaults per
# ../sanity/sanity-wiring.md §3. `.env.example` is the ONLY env file that
# is committed (see .gitignore) — never put real secrets in it.

# Sanity — the project ID is public by design (it ships in client code).
# Project: Ernesto's own Sanity account, created 2026-11-15.
PUBLIC_SANITY_PROJECT_ID=xbq1m2t8
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-01-01

# Data-layer switch (wiring guide §6: USE_SANITY = this var === '1').
# LEAVE OFF — the site renders from the local src/data/ files until the
# Sanity seed import is verified against them (DEPLOY.md §3). Flip to 1
# only at the deploy step, on the preview first.
PUBLIC_USE_SANITY=0

# No read token is needed while the dataset is public (the plan). If the
# dataset is ever set private, a read token is required — it is delivered
# via Secure Vault and set ONLY in .env / the Pages dashboard, never here.
